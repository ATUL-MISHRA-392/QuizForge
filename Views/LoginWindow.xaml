<Window x:Class="QuizForge.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizForge - Login"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side -->
        <Grid Grid.Column="0" Background="#2563EB">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="QuizForge"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Interactive Quiz &amp; Assessment Platform"
                           Foreground="White"
                           FontSize="18"
                           Margin="0,10,0,0"
                           TextAlignment="Center"/>

                <TextBlock Text="Test your knowledge. Track your progress."
                           Foreground="#DBEAFE"
                           FontSize="15"
                           Margin="0,25,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Login Form -->
        <Grid Grid.Column="1">
            <Border Background="White"
                    CornerRadius="15"
                    Margin="45"
                    Padding="35">

                <StackPanel>

                    <TextBlock Text="Welcome Back"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="Login to continue"
                               FontSize="15"
                               Foreground="#64748B"
                               Margin="0,5,0,30"/>

                    <TextBlock Text="Email"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <TextBox x:Name="EmailTextBox"
                             Height="42"
                             FontSize="15"
                             Padding="10"
                             Margin="0,8,0,20"/>

                    <TextBlock Text="Password"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <PasswordBox x:Name="PasswordBox"
                                 Height="42"
                                 FontSize="15"
                                 Padding="10"
                                 Margin="0,8,0,25"/>

                    <Button x:Name="LoginButton"
                            Content="LOGIN"
                            Height="45"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LoginButton_Click"/>
                    <Button Content="CREATE NEW ACCOUNT"
                            Height="40"
                            Margin="0,10,0,0"
                            Background="Transparent"
                            Foreground="#2563EB"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="RegisterButton_Click"/>

                    <TextBlock x:Name="MessageTextBlock"
                               Text=""
                               Foreground="#DC2626"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"
                               TextAlignment="Center"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>