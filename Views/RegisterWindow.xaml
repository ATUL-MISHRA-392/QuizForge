<Window x:Class="QuizForge.Desktop.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizForge - Register"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side -->
        <Grid Grid.Column="0" Background="#2563EB">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="QuizForge"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Create your account"
                           Foreground="White"
                           FontSize="20"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Join and start testing your knowledge."
                           Foreground="#DBEAFE"
                           FontSize="15"
                           Margin="0,25,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Register Form -->
        <Grid Grid.Column="1">

            <Border Background="White"
                    CornerRadius="15"
                    Margin="45"
                    Padding="35">

                <StackPanel>

                    <TextBlock Text="Create Account"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="Register as a student"
                               FontSize="15"
                               Foreground="#64748B"
                               Margin="0,5,0,22"/>

                    <TextBlock Text="Full Name"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <TextBox x:Name="FullNameTextBox"
                             Height="40"
                             FontSize="15"
                             Padding="10"
                             Margin="0,7,0,15"/>

                    <TextBlock Text="Email"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <TextBox x:Name="EmailTextBox"
                             Height="40"
                             FontSize="15"
                             Padding="10"
                             Margin="0,7,0,15"/>

                    <TextBlock Text="Password"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <PasswordBox x:Name="PasswordBox"
                                 Height="40"
                                 FontSize="15"
                                 Padding="10"
                                 Margin="0,7,0,20"/>

                    <Button x:Name="RegisterButton"
                            Content="CREATE ACCOUNT"
                            Height="45"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="RegisterButton_Click"/>

                    <TextBlock x:Name="MessageTextBlock"
                               Text=""
                               Foreground="#DC2626"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"
                               TextAlignment="Center"/>

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>