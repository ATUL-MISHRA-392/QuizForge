<Window x:Class="QuizForge.Desktop.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizForge - Dashboard"
        Height="700"
        Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->

        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}">

            <Grid Margin="30,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="QuizForge"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Interactive Quiz &amp; Assessment Platform"
                               FontSize="12"
                               Foreground="#DDEAF4"
                               Margin="2,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <StackPanel VerticalAlignment="Center"
                                Margin="0,0,22,0">

                        <TextBlock Text="WELCOME"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#BFD7EA"
                                   HorizontalAlignment="Right"/>

                        <TextBlock x:Name="WelcomeTextBlock"
                                   Text="Welcome!"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Button Content="LOGOUT"
                            Width="90"
                            Height="36"
                            Background="White"
                            Foreground="{StaticResource PrimaryBrush}"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LogoutButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================= MAIN CONTENT ================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="45,35,45,40">

                <!-- Welcome Section -->

                <TextBlock Text="Welcome to QuizForge 👋"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Choose an option below to continue your learning journey."
                           FontSize="16"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,8,0,30"/>

                    <!-- Dashboard Statistics -->
<Grid Margin="0,0,0,25">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Total Attempts -->
    <Border Grid.Column="0"
            Style="{StaticResource CardStyle}"
            Margin="0,0,8,0"
            Padding="20">

        <StackPanel>
            <TextBlock Text="QUIZ ATTEMPTS"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <TextBlock x:Name="TotalAttemptsTextBlock"
                       Text="0"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,6,0,0"/>

            <TextBlock Text="Completed quizzes"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

    </Border>

    <!-- Questions -->
    <Border Grid.Column="1"
            Style="{StaticResource CardStyle}"
            Margin="4,0"
            Padding="20">

        <StackPanel>
            <TextBlock Text="QUESTIONS"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <TextBlock x:Name="TotalQuestionsTextBlock"
                       Text="0"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,6,0,0"/>

            <TextBlock Text="Available questions"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

    </Border>

    <!-- Best Score -->
    <Border Grid.Column="2"
            Style="{StaticResource CardStyle}"
            Margin="4,0"
            Padding="20">

        <StackPanel>
            <TextBlock Text="BEST SCORE"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <TextBlock x:Name="BestScoreTextBlock"
                       Text="0"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource SecondaryBrush}"
                       Margin="0,6,0,0"/>

            <TextBlock Text="Highest quiz score"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

    </Border>

    <!-- Average -->
    <Border Grid.Column="3"
            Style="{StaticResource CardStyle}"
            Margin="8,0,0,0"
            Padding="20">

        <StackPanel>
            <TextBlock Text="AVERAGE"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <TextBlock x:Name="AveragePercentageTextBlock"
                       Text="0%"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,6,0,0"/>

            <TextBlock Text="Average percentage"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

    </Border>

</Grid>
                <!-- ================= FEATURE CARDS ================= -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- START QUIZ -->

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Margin="0,0,10,0"
                            Padding="25">

                        <StackPanel>

                            <Border Width="58"
                                    Height="58"
                                    CornerRadius="12"
                                    Background="#E8F1FA"
                                    HorizontalAlignment="Left">

                                <TextBlock Text="🎯"
                                           FontSize="30"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Start Quiz"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,18,0,7"/>

                            <TextBlock Text="Choose a category and challenge yourself with multiple-choice questions."
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       MinHeight="48"/>

                            <Button Content="START QUIZ  →"
                                    Height="44"
                                    Margin="0,22,0,0"
                                    Background="{StaticResource PrimaryBrush}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="StartQuizButton_Click"/>

                        </StackPanel>

                    </Border>


                    <!-- CATEGORIES -->

                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Margin="5,0"
                            Padding="25">

                        <StackPanel>

                            <Border Width="58"
                                    Height="58"
                                    CornerRadius="12"
                                    Background="#E8F8FA"
                                    HorizontalAlignment="Left">

                                <TextBlock Text="📚"
                                           FontSize="30"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Categories"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,18,0,7"/>

                            <TextBlock Text="Explore subjects such as Programming, Science, Mathematics and more."
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       MinHeight="48"/>

                            <Button Content="VIEW CATEGORIES  →"
                                    Height="44"
                                    Margin="0,22,0,0"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="CategoriesButton_Click"/>

                        </StackPanel>

                    </Border>


                    <!-- HISTORY -->

                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Margin="10,0,0,0"
                            Padding="25">

                        <StackPanel>

                            <Border Width="58"
                                    Height="58"
                                    CornerRadius="12"
                                    Background="#E7F8F1"
                                    HorizontalAlignment="Left">

                                <TextBlock Text="📊"
                                           FontSize="30"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Quiz History"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,18,0,7"/>

                            <TextBlock Text="Review your previous attempts, scores and quiz performance."
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       MinHeight="48"/>

                            <Button Content="VIEW HISTORY  →"
                                    Height="44"
                                    Margin="0,22,0,0"
                                    Background="{StaticResource SecondaryBrush}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="HistoryButton_Click"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================= ABOUT SECTION ================= -->

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,28,0,0"
                        Padding="28">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="60"
                                Height="60"
                                CornerRadius="30"
                                Background="#E8F1FA"
                                VerticalAlignment="Top">

                            <TextBlock Text="💡"
                                       FontSize="30"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="20,0,0,0">

                            <TextBlock Text="About QuizForge"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Text="QuizForge is an interactive quiz and assessment platform designed to help students test their knowledge, practice multiple-choice questions, receive instant results and track their performance over time."
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- Footer -->

                <TextBlock Text="QuizForge • Learn • Practice • Improve"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,25,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>