<Window x:Class="QuizForge.Desktop.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizForge - Result"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid>

        <Grid Height="80"
              VerticalAlignment="Top"
              Background="#2563EB">

            <StackPanel VerticalAlignment="Center"
                        Margin="30,0,0,0">

                <TextBlock Text="QuizForge"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Quiz Result"
                           Foreground="#DBEAFE"
                           FontSize="14"/>

            </StackPanel>

        </Grid>

        <ScrollViewer Margin="40,110,40,30">

            <StackPanel>

                <TextBlock x:Name="CategoryTextBlock"
                           Text="Programming"
                           FontSize="18"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Quiz Completed!"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,30"/>

                <Border Background="White"
                        CornerRadius="20"
                        Padding="40"
                        HorizontalAlignment="Center"
                        Width="600">

                    <StackPanel>

                        <TextBlock Text="Your Score"
                                   FontSize="20"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="ScoreTextBlock"
                                   Text="0 / 5"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,30"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#DCFCE7"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="5">

                                <StackPanel>

                                    <TextBlock Text="Correct"
                                               FontSize="15"
                                               Foreground="#166534"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="CorrectTextBlock"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#16A34A"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                            <Border Grid.Column="1"
                                    Background="#FEE2E2"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="5">

                                <StackPanel>

                                    <TextBlock Text="Wrong"
                                               FontSize="15"
                                               Foreground="#991B1B"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="WrongTextBlock"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#DC2626"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                            <Border Grid.Column="2"
                                    Background="#FEF3C7"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="5">

                                <StackPanel>

                                    <TextBlock Text="Skipped"
                                               FontSize="15"
                                               Foreground="#92400E"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="SkippedTextBlock"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#D97706"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <TextBlock x:Name="PercentageTextBlock"
                                   Text="Percentage: 0%"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   HorizontalAlignment="Center"
                                   Margin="0,30,0,20"/>

                        <Button Content="BACK TO DASHBOARD"
                                Width="220"
                                Height="45"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Center"
                                Click="DashboardButton_Click"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>