<Window x:Class="QuizForge.Desktop.Views.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizForge - Categories"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid>

        <!-- Header -->
        <Grid Height="75"
              VerticalAlignment="Top"
              Background="#2563EB">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="30,0,0,0">

                <TextBlock Text="QuizForge"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="  |  Categories"
                           Foreground="#DBEAFE"
                           FontSize="18"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <!-- Main Content -->
        <ScrollViewer Margin="30,100,30,30">

            <StackPanel>

                <TextBlock Text="Choose a Category"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Select a category to start your quiz."
                           FontSize="16"
                           Foreground="#64748B"
                           Margin="0,8,0,25"/>

                <!-- Categories will appear here -->
                <ItemsControl x:Name="CategoriesItemsControl">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Width="270"
                                    Height="150"
                                    Background="White"
                                    CornerRadius="15"
                                    Margin="0,0,20,20"
                                    Padding="25">

                                <StackPanel>

                                    <TextBlock Text="📚"
                                               FontSize="35"/>

                                    <TextBlock Text="{Binding CategoryName}"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"
                                               Margin="0,10,0,0"/>

                                    <Button Content="START QUIZ"
                                            Height="35"
                                            Margin="0,12,0,0"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Tag="{Binding CategoryId}"
                                            Click="StartQuizButton_Click"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <!-- Loading -->
                <TextBlock x:Name="MessageTextBlock"
                           Text=""
                           Foreground="#DC2626"
                           FontSize="15"
                           Margin="0,10,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>